<Window x:Class="StudentNameChanged.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentNameChanged"
        mc:Ignorable="d" 
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Name="stackPanel" >
        <TextBox Text="{Binding Source=Student,Path=Name }" Height="40" Width="150" Margin="5"/>
        <Button Name="button" Width="150" Height="40" Content="ChangeName" Click="button_Click" Margin="5"/>

    </StackPanel>
</Window>
