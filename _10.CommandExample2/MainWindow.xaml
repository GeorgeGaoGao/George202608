<Window x:Class="_10.CommandExample2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_10.CommandExample2"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel>
        <Button Command="{Binding ClearCommand}" Content="Clear Text" Height="50" Margin="5"/>
        <TextBox Text="{Binding TextContent,UpdateSourceTrigger=PropertyChanged}" Height="150" Margin="5 0 5 0"/>
    </StackPanel>
</Window>
