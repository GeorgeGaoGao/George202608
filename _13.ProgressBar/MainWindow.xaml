<Window x:Class="_13.ProgressBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_13.ProgressBar" FontSize="20"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding MainWindowLoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <Rectangle Width="{Binding LeftMargin}"/>
            <TextBlock Name="myTextBlock" Grid.Column="1"   Text="{Binding Value, StringFormat={}{0}%}" HorizontalAlignment="left"/>
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Value }" Margin="10"  Height="15"/>
    </StackPanel>
</Window>
