<Window x:Class="_14.CalendarExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_14.CalendarExercise"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    
    
    <StackPanel>
        <Calendar DisplayDateStart="2026-01-01" DisplayDateEnd="2026-08-31" 
                  SelectionMode="MultipleRange"
                  local:MainWindowViewModel.SelectedDates="{Binding ChosenDates}"
                  SelectedDate="{Binding SelectedDate}"/>
        <Button Content="ChooseDate" Command="{Binding ChooseDateCommand}">
            <!--<i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                    <i:InvokeCommandAction Command="{Binding ChooseDateCommand }"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>-->
        </Button>
    </StackPanel>
</Window>
