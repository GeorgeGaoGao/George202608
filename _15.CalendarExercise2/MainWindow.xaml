<Window x:Class="_15.CalendarExercise2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_15.CalendarExercise2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel Margin="10">
        <Calendar Name="myCalendar" DisplayDateStart="2026-01-01"
          DisplayDateEnd="2026-12-31" 
                  SelectionMode="MultipleRange"
                  local:MainWindowViewModel.SelectedDates="{Binding ChosenDates}"
                  SelectedDate="{Binding CurrentSelectedDate}"/>
        <Button Width="180"  Height="30" Margin="0 5" Content="Show Dates" Command="{Binding ButtonShowInfoCommand}"/>
        <Button Width="180" Height="30" Margin="0 5" Content="Change SelectedDate"
                Command="{Binding ButtonChangeSelectedDateCommand}"/>
        <Button Name="button3" Width="180" Height="30" Margin="0 5" Content="ClickToShowSelectedDates" Click="Button_Click"/>
        <PasswordBox Width="180" Height="30" local:MainWindowViewModel.Password="{Binding MyPassword}"/>
    </StackPanel>
</Window>
