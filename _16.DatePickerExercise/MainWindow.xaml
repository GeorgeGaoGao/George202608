<Window x:Class="_16.DatePickerExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_16.DatePickerExercise"
        mc:Ignorable="d" FontSize="20"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="3"/>
            <DatePicker Name="datePickerStart" Margin="3" SelectedDate="{Binding StartDate}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="3"/>
            <DatePicker Name="datePickerEnd" Margin="3" SelectedDate="{Binding EndDate}"/>
        </StackPanel>
        <Button Width="200" Height="40" Content="click me" 
                Command="{Binding CalculateDatesCommand}"/>
        <Button Width="200" Height="40" Content="button_click" Click="Button_Click"/>
    </StackPanel>
    
</Window>
