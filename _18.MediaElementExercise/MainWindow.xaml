<Window x:Class="_18.MediaElementExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_18.MediaElementExercise"
        mc:Ignorable="d" FontSize="20"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <MediaElement Name="myMediaElement" LoadedBehavior="Manual" />
        <Border Background="Black" Name="myBorder">
            <TextBlock Name="myTextBlock" Text="mediaElement || 媒体播放器" Foreground="LightCoral" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Width="130" Content="Open" Click="OpenMedia" Margin="3"/>
            <Button Width="130" Content="Play" Click="PlayMedia" Margin="3"/>
            <Button Width="130" Content="Stop" Click="StopMedia" Margin="3"/>
            <Button Width="130" Content="Backward" Click="BackwardMedia" Margin="3"/>
            <Button Width="130" Content="Forward" Click="ForwardMedia" Margin="3"/>
            <TextBlock Width="100" Text="Volume"  Margin="3" />
            <Slider Minimum="0" Maximum="100" Value="50" Width="150" Margin="3" VerticalAlignment="center" ValueChanged="Slider_ValueChanged"/>
        </StackPanel>

        <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="0" Height="20" Margin="0 10" Foreground="Green"/>
    </Grid>
</Window>
