<Window x:Class="_20.Review.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20.Review"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel>
        <Calendar Name="myCalendar" DisplayDateStart="2026-08-01" DisplayDateEnd="2026-08-31" SelectionMode="MultipleRange"
                  SelectedDate="{Binding SelectedDate}" local:MainWindowViewModel.SelectedDates="{Binding SelectedDates}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedDatesChanged">
                    <i:InvokeCommandAction Command="{Binding SelectedDatesChangedCommand }" CommandParameter="{Binding ElementName=myCalendar}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Calendar>
        <Button Content="ShowCalendarInfo" Width="180" Height="40" Command="{Binding ShowDatesInfoCommand}" CommandParameter="button A"/>
    </StackPanel>

</Window>
