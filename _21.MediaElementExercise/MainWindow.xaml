<Window x:Class="_21.MediaElementExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_21.MediaElementExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <MediaElement Name="myMediaElement" LoadedBehavior="Manual"/>
        <Border Background="Black" Visibility="{Binding BorderVisibility }" >
            <TextBlock Text="" Foreground="LightCoral" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <UniformGrid Grid.Row="1" Rows="1">
            <Button Content="Open" Margin="1" Command="{Binding OpenFileCommand}" CommandParameter="{Binding ElementName=myMediaElement}"/>
            <Button Content="Play" Margin="1" Command="{Binding PlayCommand}"/>
            <Button Content="Pause" Margin="1"/>
            <Button Content="Foreward" Margin="1"/>
            <Button Content="Backward" Margin="1"/>
            <StackPanel >
                 <Label Content="Volume" Margin="1" FontSize="10" HorizontalAlignment="Center"/>
            <Slider Minimum="0" Maximum="100" Value="50" Height="10" Background="Green"/>
            </StackPanel>
        </UniformGrid>
        <Grid Grid.Row="2">
            <ProgressBar Height="10" Margin="5" Minimum="0" Maximum="{Binding MediaTimeSpan.TotalMilliseconds}" Foreground="Green"/>
        </Grid>
    </Grid>
</Window>
