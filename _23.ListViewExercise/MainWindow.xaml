<Window x:Class="_23.ListViewExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_23.ListViewExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <ComboBox Name="myComboBox1" IsEditable="True" Height="30" Margin="10" TextBoxBase.TextChanged="myComboBox1_TextChanged"/>
            <ComboBox Name="myComboBox2" ItemsSource="{Binding People}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPerson}"
                      StaysOpenOnEdit="True" Height="30" Margin="10" SelectionChanged="myComboBox2_SelectionChanged"/>
        </StackPanel>
        
        <!--<DataGrid Grid.Column="0" Margin="5" SelectionChanged="ListView_SelectionChanged" 
                  AutoGenerateColumns="False"
                  Name="myListView" SelectedItem="{Binding SelectedPerson}" ItemsSource="{Binding People}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Address}"/>
                <DataGridTextColumn Header="年龄" Binding="{Binding Age}"/>
            </DataGrid.Columns>
        </DataGrid>-->
        <!--<ListView Grid.Column="0" Margin="5" SelectionChanged="ListView_SelectionChanged" 
                  Name="myListView" SelectedItem="{Binding SelectedPerson}" ItemsSource="{Binding People}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="姓名" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="地址" DisplayMemberBinding="{Binding Address}"/>
                    <GridViewColumn Header="年龄" DisplayMemberBinding="{Binding Age}"/>
                </GridView>
            </ListView.View>
        </ListView>-->
        <StackPanel Grid.Column="1">
            <StackPanel  Orientation="Horizontal">
                <TextBlock  Text="姓名" Width="50"  Height="30" FontSize="20" Margin="5"/>
                <TextBlock Name="nameTextBlock" Text="{Binding SelectedPerson.Name}"  FontSize="16" VerticalAlignment="Center" Background="LightCoral" />
            </StackPanel>
            <StackPanel  Orientation="Horizontal">
                <TextBlock  Text="年龄" Width="50"  Height="30" FontSize="20" Margin="5"/>
                <TextBlock Name="ageTextBlock" Text="{Binding SelectedPerson.Age}" FontSize="16" VerticalAlignment="Center" Background="LightCoral" />
            </StackPanel>
            <StackPanel  Orientation="Horizontal">
                <TextBlock  Text="地址" Width="50"  Height="30" FontSize="20" Margin="5"/>
                <TextBlock Name="addressTextBlock" Text="{Binding SelectedPerson.Address}"   FontSize="16" VerticalAlignment="Center" Background="LightCoral" />
            </StackPanel>
            <StackPanel  Orientation="Horizontal">
                <TextBlock  Text="电话" Width="50"  Height="30" FontSize="20" Margin="5"/>
                <TextBlock x:Name="phoneTextBlock" Text="{Binding SelectedPerson.Address}"   FontSize="16" VerticalAlignment="Center" Background="LightCoral" />
            </StackPanel>
        </StackPanel>
        

    </Grid>
</Window>
