<Window x:Class="_27.TabControlExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_27.TabControlExercise"
        mc:Ignorable="d" FontSize="20"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <TabControl Name="myTabControl" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Name="myFirst" Header="首页">
                <Border Background="LightBlue">
                    <TextBlock Text="首页内容" FontSize="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </TabItem>
            <TabItem Name="mySecond" Header="次页">
                
                    <TextBlock Text="次页内容" FontSize="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
               
            </TabItem>
            <TabItem Name="myThird" Header="第三页">
                <StackPanel Background="Orange">
                    <TextBlock Text="第三页内容" FontSize="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem>
          
        </TabControl>
        <TextBlock Name="myTextBlock" Grid.Row="1" />
    </Grid>
</Window>
