<Window x:Class="_28.TreeViewExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_28.TreeViewExercise"
        mc:Ignorable="d" FontSize="20"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="根目录" Width="60" FontSize="20" VerticalAlignment="Center"/>
            <TextBox Name="myTextBox" Width="500" VerticalContentAlignment="Center"/>
            <Button Width="80" Content="选择..." Click="Button_Click"/>
        </StackPanel>
        <TreeView Name="myTreeView" Grid.Row="1" SelectedItemChanged="TreeView_SelectedItemChanged"/>
    </Grid>
</Window>
