<Window x:Class="_31.MenuContextExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_31.MenuContextExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Border Name="myBorder" Width="400" Height="200" Background="Transparent">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Name="myMenuItem" Header="copy" Click="MenuItem_Click"/>
                    <MenuItem Header="cut"/>
                    <MenuItem Header="paste"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Button Name="myButton" Content="click me" Width="100" Height="40"/>
        </Border>
    </Grid>
</Window>
