<Window x:Class="_33.EllipseExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_33.EllipseExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="200" Height="300" Stroke="Red" StrokeThickness="2" Fill="Green">
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation From="200" To="300" Duration="0:0:2" AutoReverse="True"
                                             RepeatBehavior="Forever" Storyboard.TargetProperty="Width"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
        <Line Name="myLine" X1="0" Y1="0" X2="500" Y2="300" Stroke="Green" 
              StrokeThickness="4" StrokeDashArray="5,4" />
        <StackPanel Grid.Column="1">
            <Rectangle Stroke="Red" Width="100" Height="100" RadiusX="50" RadiusY="30" 
                       Fill="Orange" StrokeThickness="3"/>
            <Polyline Points="30,30 250,30 30,330 250,330" StrokeThickness="3">
                <Polyline.Stroke >
                    <LinearGradientBrush StartPoint="30,30" EndPoint="250,330" MappingMode="Absolute" >
                        <GradientStop Offset="1" Color="Red"/>
                        <GradientStop Offset="0.5" Color="Yellow"/>
                        <GradientStop Offset="0" Color="Green"/>
                    </LinearGradientBrush>
                </Polyline.Stroke>
            </Polyline>
        </StackPanel>
    </Grid>
</Window>
