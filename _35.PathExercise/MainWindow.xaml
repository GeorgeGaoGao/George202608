<Window x:Class="_35.PathExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_35.PathExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Path Stroke="Blue" Fill="Red">
            <Path.Data>
                <RectangleGeometry Rect="100 100 20 20"/>
               
            </Path.Data>
        </Path>
        <Path Stroke="Green" Fill="Orange">
            <Path.Data>
                <LineGeometry StartPoint="10 10" EndPoint="120 90"/>
            </Path.Data>
        </Path>
        <Path Stroke="Orange" Fill="Green">
            <Path.Data>
                <EllipseGeometry Center="100 100" RadiusX="100" RadiusY="50"/>
            </Path.Data>
        </Path>
    </Grid>
</Window>
