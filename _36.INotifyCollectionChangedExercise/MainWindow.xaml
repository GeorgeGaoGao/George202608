<Window x:Class="_36.INotifyCollectionChangedExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_36.INotifyCollectionChangedExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListView Grid.Column="0" ItemsSource="{Binding People}"/>
        <StackPanel Grid.Column="1" Margin="20 50">
            <StackPanel Orientation="Horizontal" Height="30" Margin="5">
                <TextBlock Text="Name" VerticalAlignment="Center" Width="50"/>
                <TextBox Text="{Binding CurrentPerson.Name}" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="30" Margin="5">
                <TextBlock Text="Age"  VerticalAlignment="Center" Width="50"/>
                <TextBox Text="{Binding CurrentPerson.Age}" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="30" Margin="5">
                <TextBlock Text="Address" VerticalAlignment="Center" Width="50"/>
                <TextBox Text="{Binding CurrentPerson.Address}" Width="200"/>
            </StackPanel>
            <Button Command="{Binding }" Content="Add person" Width="250" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
