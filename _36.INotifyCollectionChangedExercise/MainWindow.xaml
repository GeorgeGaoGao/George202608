<Window x:Class="_36.INotifyCollectionChangedExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_36.INotifyCollectionChangedExercise"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d" 
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <local:AgeToBrushConverter x:Key="AgeToBrushConverter"/>
        <local:TitleMultiConverter x:Key="TitleMultiConverter"/>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding CloseWindowCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedWindowCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Green" BorderThickness="1"  Grid.Column="0" Margin="10">
            <ListView ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" >
                <ListView.View>
                    <GridView>
                        <GridView.Columns>
                            <GridViewColumn Header="Name" Width="auto" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Age" Width="auto" DisplayMemberBinding="{Binding Age}" />
                            <GridViewColumn Header="Address" Width="auto" DisplayMemberBinding="{Binding Address}"/>
                            <GridViewColumn Header="Money" Width="auto" DisplayMemberBinding="{Binding Money}"/>
                        </GridView.Columns>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Column="1" Margin="20 50" 
                    Background="{Binding SelectedPerson.Age,Converter={StaticResource AgeToBrushConverter},ConverterParameter=999}">

            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Name" Width="50" Margin="5" VerticalAlignment="Center"/>
                <TextBox VerticalContentAlignment="Center"  Width="200" Height="40"  >
                    <TextBox.Text>
                        <Binding Path="CurrentPerson.Name" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:NameValidationRule ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" BorderBrush="Red" BorderThickness="1">
                                    <AdornedElementPlaceholder Name="AdornedElementPlaceholder"/>
                                </Border>
                                <Grid >
                                    <TextBlock Text="{Binding ElementName=AdornedElementPlaceholder,
                                        Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                                               Foreground="red" VerticalAlignment="Center"/>
                                </Grid>

                            </DockPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>
            </StackPanel>


            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Age" Width="50" Margin="5" VerticalAlignment="Center"/>
                <TextBox VerticalContentAlignment="Center"  Width="200" Height="40">
                    <TextBox.Text>
                        <Binding Path="CurrentPerson.Age" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:AgeValidationRule ValidatesOnTargetUpdated="True"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" BorderBrush="Red" BorderThickness="1" >
                                    <AdornedElementPlaceholder Name="AdornedElementPlaceholder"/>
                                </Border>
                                <Grid DockPanel.Dock="Right">
                                    <TextBlock Foreground="Red" VerticalAlignment="Center" 
                                               Text="{Binding ElementName=AdornedElementPlaceholder, 
                                        Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>

                                </Grid>
                            </DockPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Address" Width="50" Margin="5" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CurrentPerson.Address}" Width="200" Height="40"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Money" Width="50" Margin="5" VerticalAlignment="Center"/>
                <TextBox Width="200" Height="40">
                    <TextBox.Text>
                        <Binding Path="CurrentPerson.Money" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:MoneyValidationRule ValidatesOnTargetUpdated="True"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" BorderBrush="Red" BorderThickness="1">
                                    <AdornedElementPlaceholder Name="AdornedElementPlaceholder"/>
                                </Border>
                                <Grid>
                                    <TextBlock Text="{Binding ElementName=AdornedElementPlaceholder,
                                        Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"
                                               Foreground="Red"/>
                                </Grid>
                            </DockPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>
            </StackPanel>
            
            

            <TextBlock Height="40">
                <Run Text="Title"/>
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource TitleMultiConverter}">
                            <Binding Path="SelectedPerson.Age"/>
                            <Binding Path="SelectedPerson.Money"/>
                        </MultiBinding>
                    </Run.Text>
                </Run>
            </TextBlock>


            <Button Content="Add person"
                    Command="{Binding AddPersonCommand}"
                    Width="200" Height="30" Margin="20 0 50 5"/>
            <Button Content="Remove person"
                    Command="{Binding RemovePersonCommand}"
                    Width="200" Height="30" Margin="20 0 50 5"/>
        </StackPanel>
    </Grid>
</Window>
