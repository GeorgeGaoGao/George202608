<Window x:Class="_38.ValidationRulesReview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38.ValidationRulesReview"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid Margin="3">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Name" Width="50" />
                <TextBox Width="200" Height="30" VerticalContentAlignment="Center">
                    <TextBox.Text>
                        <Binding Path="StudentName" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:StudentNameValidationRule ValidatesOnTargetUpdated="True"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                    <Validation.ErrorTemplate>
                        <ControlTemplate>
                            <DockPanel>
                                <Border BorderBrush="red" BorderThickness="1" DockPanel.Dock="Left">
                                    <AdornedElementPlaceholder Name="AdornedElementPlaceholder"/>
                                </Border>
                                <Grid>
                                    <TextBlock Foreground="Red" VerticalAlignment="Center"
                                               Text="{Binding ElementName=AdornedElementPlaceholder, 
                                        Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
                                </Grid>
                            </DockPanel>
                        </ControlTemplate>
                    </Validation.ErrorTemplate>
                </TextBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
