<Window x:Class="_39.ResourcesExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_39.ResourcesExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="WindowButtonGreenStyle" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Content" Value="button window"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="5">
            <Button >
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="200"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Background" Value="Red"/>
                        <Setter Property="Content" Value="button original"/>
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Style="{StaticResource WindowButtonGreenStyle}" />
            <Button Style="{StaticResource ApplicationButtonOrangeStyle}"/>
            <Button Style="{StaticResource FileButtonPinkStyle}"/>
        </StackPanel>

    </Grid>
</Window>
