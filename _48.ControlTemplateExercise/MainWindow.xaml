<Window x:Class="_48.ControlTemplateExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_48.ControlTemplateExercise"
        mc:Ignorable="d" FontSize="20"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <ControlTemplate TargetType="Button" x:Key="ButtonStyle01">
            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                    Background="Transparent" BorderBrush="Green" 
                    CornerRadius="5" BorderThickness="1">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <StackPanel>
            <Border>
                <Button Width="250" Height="50" Content="click me">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                Background="Transparent" BorderBrush="Red" 
                                CornerRadius="5"
                                BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate >
                    </Button.Template>

                </Button>
            </Border>
            <Button Template="{StaticResource ButtonStyle01}" Content="resources template" Height="50" Width="250" Margin="5"/>
            <Button  Content="resources template" Height="50" Width="250" Margin="5"/>
        </StackPanel>

    </Grid>
</Window>
