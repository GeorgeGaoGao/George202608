<Window x:Class="_49.TemplateBindingExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_49.TemplateBindingExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Button Margin="20" DataContext="{Binding CurrentPerson}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#DDDDDD">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding Name}" FontSize="40">
                                    <Run Text="女侠" FontSize="25"/>
                                </TextBlock>
                            </StackPanel>
                           
                        </Grid>
                    </Border>
                    
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>
