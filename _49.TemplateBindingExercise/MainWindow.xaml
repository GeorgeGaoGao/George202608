<Window x:Class="_49.TemplateBindingExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_49.TemplateBindingExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button" x:Key="cardButtonStyle">
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="Foreground" Value="Green"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                >
                            <Border.ToolTip>
                                <ContentPresenter/>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock  FontSize="60" Text="{Binding Name}" Foreground="{TemplateBinding Foreground}" Margin="15"/>
                                    <TextBlock Text="大侠" FontSize="25" Margin="15"/>
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Grid.Column="0" Text="@" Foreground="Red" 
                                               FontSize="100" VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"/>
                                    <StackPanel Margin="50 0 0 0" TextElement.FontSize="50">
                                        <TextBlock Text="company name" Foreground="{TemplateBinding Foreground}"/>
                                            <TextBlock Text="Age:">
                                                <Run Text="{Binding Age}"/>
                                            </TextBlock>
                                            <TextBlock Text="Address:">
                                                <Run Text="{Binding Address}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
