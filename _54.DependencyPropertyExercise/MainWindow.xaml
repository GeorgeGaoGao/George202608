<Window x:Class="_54.DependencyPropertyExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_54.DependencyPropertyExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <StackPanel>
            <TextBlock Text="什么是依赖属性" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <local:WidgetUserControl x:Name="myWidget" Icon="¥" 
                                          ValueTarget="100" Completed="myWidget_Completed"
                                         local:SalesManager.Check="myWidget_Check"
                                         Value="{Binding ElementName=mySlider, Path=Value}" Title="总销售额"  Width="200" Height="100" BorderThickness="1" />
                <local:WidgetUserControl/>
            </StackPanel>
            <Slider Name="mySlider" Minimum="0" Maximum="2000"  Height="20" IsSnapToTickEnabled="True"/>
            <ListBox Name="myListBox" VerticalAlignment="Top" Width="400" Height="200"/>
        </StackPanel>

    </Grid>
</Window>
