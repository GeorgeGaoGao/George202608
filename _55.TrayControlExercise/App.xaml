<Application x:Class="_55.TrayControlExercise.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_55.TrayControlExercise"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="checkBoxTrayStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="Orange" BorderThickness="2"
                                CornerRadius="{Binding RelativeSource={RelativeSource Mode=Self},Path=Width}">
                            <TextBlock Text="{TemplateBinding Name }" Name="textBlock" FontSize="25"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                  
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
