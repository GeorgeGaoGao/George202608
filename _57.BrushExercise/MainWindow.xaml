<Window x:Class="_57.BrushExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_57.BrushExercise"
        mc:Ignorable="d" MouseMove="Window_MouseMove" MouseWheel="Window_MouseWheel"
        Title="MainWindow" Height="450" Width="800">
    <TabControl >
        <TabItem Header="LinearGradient">
            <Grid Background="Gray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="162*"/>
                    <ColumnDefinition Width="235*"/>
                </Grid.ColumnDefinitions>
                <Border Name="myBorder" Grid.ColumnSpan="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0000" Offset="1"/>
                            <GradientStop Color="#0000ff" Offset="0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="RadialGradient">
            <Grid>
                <Ellipse Name="myEllipse" Width="300" Height="300" Stroke="Black" MouseMove="myEllipse_MouseMove">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5 0.5" GradientOrigin="0.25 0.25" RadiusX="0.5" RadiusY="0.5" >
                            <GradientStop Color="white" Offset="0"/>
                            <GradientStop Color="black" Offset="0.7"/>
                            <GradientStop Color="Gray"  Offset="1"/>

                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </TabItem>
        <TabItem Header="ImageBrush">
            <Grid Name="myGrid">
                <Grid.Background>
                    <ImageBrush ImageSource="/Images/photo.jpg" 
                                Stretch="Uniform" Viewport="0 0 1 1 " TileMode="Tile" >



                    </ImageBrush>
                </Grid.Background>
            </Grid>
        </TabItem>
        <TabItem Header="VisualBrush">
            <Grid MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave" MouseMove="Grid_MouseMove">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Image Name="myImage" Source="/Images/painting.jpg" Stretch="UniformToFill">
                    
                </Image>
                <Canvas Name="myCanvas" IsHitTestVisible="False">
                    <Ellipse Name="myVisualEllipse" Width="200" Height="200" Stroke="Red" StrokeThickness="1" >
                        <Ellipse.Fill>
                            <VisualBrush x:Name="myVisualBrush"  ViewboxUnits="Absolute" Visual="{Binding ElementName=myImage}"/>

                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBox Width="600" Height="30" Margin="5" VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <VisualBrush x:Key="waterText"
                                         Opacity="0.5"
                                         AlignmentX="Left"
                                         AlignmentY="Center"
                                         TileMode="None"
                                         Stretch="None"
                                         >
                                <VisualBrush.Visual>
                                    <TextBlock Text="请输入画家名或画名" HorizontalAlignment="Left"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource waterText}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource waterText}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Content="搜索名家名画" Margin="5"/>
                </StackPanel>
            </Grid>
        </TabItem>

    </TabControl>



</Window>
