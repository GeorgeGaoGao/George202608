<Window x:Class="_58.EffectExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_58.EffectExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Name="myGrid" MouseMove="myButton_MouseMove" Background="Transparent">
        <Button Name="myButton"  Content="click me" Width="300" Height="100" FontSize="50">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="20" Color="Gray" BlurRadius="10"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>
