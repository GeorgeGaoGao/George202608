<Window x:Class="_59.BlurEffectExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_59.BlurEffectExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Storyboard x:Key="widthStoryboard" TargetProperty="Width">
            <DoubleAnimation  From="300" To="400" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        <Storyboard x:Key="heightStoryboard" TargetProperty="Height">
            <DoubleAnimation  From="300" To="400" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>
    <Grid Name="myGrid" Background="Transparent" MouseMove="Grid_MouseMove">
        <Ellipse Name="myEllipse" Width="300" Height="300" >
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded" >
                    <EventTrigger.Actions>
                        <BeginStoryboard Storyboard="{StaticResource widthStoryboard}"/>
                        <BeginStoryboard Storyboard="{StaticResource heightStoryboard}"/>
                    </EventTrigger.Actions>

                </EventTrigger>
            </Ellipse.Triggers>
            <Ellipse.Effect>
                <BlurEffect Radius="0"/>
            </Ellipse.Effect>
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.75" RadiusY="0.75" GradientOrigin="0.25 0.25">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="Goldenrod" Offset="0.65"/>
                    <GradientStop Color="Gray" Offset="0.8"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</Window>
