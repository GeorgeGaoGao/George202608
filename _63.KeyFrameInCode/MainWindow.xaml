<Window x:Class="_63.KeyFrameInCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_63.KeyFrameInCode"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Border Name="myBorder" MouseLeftButtonUp="myBorder_MouseLeftButtonUp">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1 0.8" EndPoint="0.8 0.2">
                    <GradientStop Color="LightBlue" Offset="0"/>
                    <GradientStop Color="DarkGoldenrod" Offset="0.5"/>
                    <GradientStop Color="Pink" Offset="0.8"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</Window>
